#!/bin/bash
# ABOUTME: Server latency evaluator - ranks VPN profiles by measured round-trip time
# ABOUTME: Pings each distinct server once, in parallel (TCP connect fallback); caches results

set -euo pipefail

# Configuration paths
CONFIG_DIR="${VPN_CONFIG_DIR:-$HOME/.config/vpn}"
LOCATIONS_DIR="${LOCATIONS_DIR:-$CONFIG_DIR/locations}"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vpn"
CACHE_FILE="$LOG_DIR/vpn_performance.cache"
LOCK_FILE="$CACHE_FILE.lock"

# This script re-invokes itself for parallel measurement workers
SELF="$(realpath "${BASH_SOURCE[0]}")"

# Tunables (environment overrides)
JOBS="${VPN_LATENCY_JOBS:-16}"              # parallel measurements
PING_COUNT="${VPN_LATENCY_PINGS:-3}"        # echo requests per server
TCP_TIMEOUT="${VPN_LATENCY_TCP_TIMEOUT:-2}" # seconds for the TCP fallback
FAST_MAX_AGE=7200                           # `best` reuses results newer than this

# Validate tunables
[[ $JOBS =~ ^[0-9]+$ && $JOBS -ge 1 ]] || JOBS=16
[[ $PING_COUNT =~ ^[0-9]+$ && $PING_COUNT -ge 1 ]] || PING_COUNT=3
# `timeout 0` means "no timeout": require at least 1 second
[[ $TCP_TIMEOUT =~ ^[0-9]+$ && $TCP_TIMEOUT -ge 1 ]] || TCP_TIMEOUT=2

# Cache format (one line per profile, tab separated):
#   <epoch> <rtt_ms> <method> <profile_path>
# method is icmp or tcp; rtt_ms and method are "-" when the server did not answer.
# Ranking prefers ICMP: a TCP handshake can be answered by a captive portal or
# transparent proxy instead of the server, so servers that answered only TCP
# are ranked after every server that answered ping (and are all there is when
# ICMP is filtered on this network). They stay in the ranking so failover
# still has candidates when some pings are lost.

usage() {
	cat << 'EOF'
VPN Server Latency Evaluator

Usage: best-vpn-profile <command> [options]

Commands:
  rank [--max-age SECONDS]  Read profile paths on stdin, print "<rtt_ms>\t<path>"
                            fastest first (unreachable servers are omitted).
                            Results newer than SECONDS are reused (default 0).
  best [country]            Print the fastest profile name (reuses results < 2h)
  fresh [country]           Like best, but always re-measure
  test [country]            Measure and print a ranked table
  cache                     Show cached measurements
  clear                     Remove cached measurements
  help, -h, --help          Show this help message

Environment:
  VPN_LATENCY_JOBS          Parallel measurements (default 16)
  VPN_LATENCY_PINGS         Pings per server (default 3)
  VPN_LATENCY_TCP_TIMEOUT   TCP fallback timeout in seconds (default 2)
EOF
}

# --- endpoint parsing -------------------------------------------------------

# Print "<host> <port> <proto>" for a profile, or nothing if none is found
profile_endpoint() {
	local profile="$1" host="" port="" proto=""
	case "$profile" in
		*.ovpn)
			proto=$(awk 'tolower($1) == "proto" {print tolower($2); exit}' "$profile" 2> /dev/null)
			read -r host port < <(awk 'tolower($1) == "remote" {print $2, $3; exit}' "$profile" 2> /dev/null) || true
			[[ -n $port ]] || port=1194
			;;
		*.conf)
			local endpoint
			endpoint=$(sed -n 's/^[[:space:]]*Endpoint[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/Ip' "$profile" 2> /dev/null | head -1)
			host="${endpoint%:*}"
			port="${endpoint##*:}"
			proto="udp"
			;;
	esac
	proto="${proto%%[0-9]*}" # udp4/tcp6-client -> udp/tcp-client
	proto="${proto%-client}"

	# Security: the host is passed to ping/bash; accept only plain hostnames/IPv4
	[[ $host =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,252})$ ]] || return 0
	[[ $port =~ ^[0-9]{1,5}$ ]] || port=443
	echo "$host $port ${proto:-udp}"
}

# --- measurement ------------------------------------------------------------

# Round-trip time in ms via ICMP (average); fails if ping is unavailable/blocked
measure_ping() {
	local host="$1" out avg
	command -v ping > /dev/null 2>&1 || return 1
	# -W only bounds each reply, not name resolution: cap the whole run
	out=$(timeout $((PING_COUNT + 2)) ping -n -q -c "$PING_COUNT" -i 0.2 -W 1 -- "$host" 2> /dev/null) || return 1
	avg=$(sed -n 's|.*= [0-9.]*/\([0-9.]*\)/.*|\1|p' <<< "$out" | head -1)
	[[ -n $avg ]] || return 1
	echo "$avg"
}

# Round-trip time in ms of a TCP handshake (fallback when ICMP is filtered).
# UDP OpenVPN servers are probed on 443, which ProtonVPN also serves over TCP.
measure_tcp() {
	local host="$1" port="$2" start end
	start=$(date +%s%N)
	timeout "$TCP_TIMEOUT" bash -c 'exec 3<> "/dev/tcp/$1/$2"' _ "$host" "$port" 2> /dev/null || return 1
	end=$(date +%s%N)
	echo $(((end - start) / 1000000))
}

# Print the address a profile is measured at, "<host> <port>", or nothing.
# UDP servers are probed on 443 (see measure_tcp), so profiles that share a
# server share one target whatever their OpenVPN port.
probe_target() {
	local endpoint host port proto
	endpoint=$(profile_endpoint "$1")
	[[ -n $endpoint ]] || return 0
	read -r host port proto <<< "$endpoint"
	[[ $proto == tcp ]] || port=443
	echo "${host,,} $port"
}

# Worker: measure one "<host> <port>" target and print
# "<host> <port>\t<rtt|->\t<method|->"
measure_target() {
	local target="$1" host port rtt="-" method="-"
	read -r host port <<< "$target"
	# Same host check as profile_endpoint (the worker can be invoked
	# directly); a malformed port is not measured
	if [[ $host =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,252})$ && $port =~ ^[0-9]{1,5}$ ]]; then
		if rtt=$(measure_ping "$host"); then
			method=icmp
		elif rtt=$(measure_tcp "$host" "$port"); then
			method=tcp
		else
			rtt="-"
		fi
	fi
	printf '%s\t%s\t%s\n' "$target" "$rtt" "$method"
}

# --- cache ------------------------------------------------------------------

ensure_private_dir() {
	(umask 077 && mkdir -p "$LOG_DIR") 2> /dev/null || return 1
	[[ -d $LOG_DIR && ! -L $LOG_DIR ]]
}

# Print cached lines for the given profiles that are newer than max_age.
# Servers that did not answer are left out, so they are measured again: one
# lost measurement must not hide a server for the whole max_age.
cached_results() {
	local max_age="$1" profiles_file="$2" now
	now=$(date +%s)
	[[ $max_age -gt 0 && -f $CACHE_FILE && ! -L $CACHE_FILE ]] || return 0
	# FILENAME test, not NR == FNR: that is also true for the 2nd file when the 1st is empty
	awk -F '\t' -v now="$now" -v max="$max_age" -v first="$profiles_file" '
		FILENAME == first { want[$0] = 1; next }
		NF == 4 && ($4 in want) && $1 ~ /^[0-9]+$/ && (now - $1) <= max && $2 != "-" { print }
	' "$profiles_file" "$CACHE_FILE"
}

# Merge fresh results into the cache (newest entry per profile wins)
update_cache() {
	local fresh="$1" tmp
	ensure_private_dir || return 0
	(
		flock -w 5 9 || exit 0
		tmp=$(mktemp "$CACHE_FILE.XXXXXX") || exit 0
		{
			[[ -f $CACHE_FILE && ! -L $CACHE_FILE ]] && awk -F '\t' 'NF == 4' "$CACHE_FILE"
			cat "$fresh"
		} | awk -F '\t' '{ last[$4] = $0 } END { for (p in last) print last[p] }' > "$tmp"
		chmod 600 "$tmp"
		mv -f "$tmp" "$CACHE_FILE" || rm -f "$tmp"
	) 9> "$LOCK_FILE"
}

# --- ranking ----------------------------------------------------------------

# Read profile paths on stdin; print "<rtt_ms>\t<path>" fastest first
rank_profiles() {
	local max_age="${1:-0}" work
	work=$(mktemp -d) || return 1
	# shellcheck disable=SC2064  # expand now: work is local
	trap "rm -rf '$work'" RETURN

	# Unique, existing, regular profile files only. Paths with control
	# characters (tabs would split the tab-separated cache) are skipped.
	while IFS= read -r p; do
		[[ -n $p && -f $p && ! -L $p && $p != *[[:cntrl:]]* ]] || continue
		# WireGuard (.conf) profiles are not offered until #223
		[[ $p == *.ovpn ]] && printf '%s\n' "$p"
	done | sort -u > "$work/profiles"
	[[ -s $work/profiles ]] || return 1

	cached_results "$max_age" "$work/profiles" > "$work/cached"
	# FILENAME test, not NR == FNR: that is also true for the 2nd file when the 1st is empty
	awk -F '\t' -v first="$work/cached" 'FILENAME == first { have[$4] = 1; next } !($0 in have)' \
		"$work/cached" "$work/profiles" > "$work/todo"

	: > "$work/fresh"
	if [[ -s $work/todo ]]; then
		# Measure each server once, not once per profile: Proton profiles share
		# a few addresses, and parallel pings to one host get dropped (#260)
		local p
		while IFS= read -r p; do
			printf '%s\t%s\n' "$(probe_target "$p")" "$p"
		done < "$work/todo" > "$work/targets"
		# Each worker is this script; one "<host> <port>" target per argument
		cut -f1 "$work/targets" | grep -v '^$' | sort -u | tr '\n' '\0' |
			xargs -0 -r -P "$JOBS" -n 1 bash "$SELF" __measure > "$work/measured" 2> /dev/null || true
		awk -F '\t' -v OFS='\t' -v now="$(date +%s)" -v first="$work/measured" '
			FILENAME == first { if (NF == 3) result[$1] = $2 OFS $3; next }
			{ print now, ($1 != "" && ($1 in result)) ? result[$1] : "-" OFS "-", $2 }
		' "$work/measured" "$work/targets" > "$work/fresh"
		update_cache "$work/fresh"
	fi

	# Servers that answered ping first, then those that answered only TCP
	cat "$work/cached" "$work/fresh" > "$work/all"
	if ! awk -F '\t' '$3 == "icmp" { found = 1 } END { exit !found }' "$work/all"; then
		echo "Note: no server answered ping; ranking by TCP handshake time (less reliable)" >&2
	fi
	awk -F '\t' -v OFS='\t' '$2 != "-" && ($3 == "icmp" || $3 == "tcp") { print ($3 == "icmp" ? 0 : 1), $2, $4 }' "$work/all" |
		sort -t "$(printf '\t')" -k1,1n -k2,2g -k3,3 | cut -f2- > "$work/ranked"
	[[ -s $work/ranked ]] || return 1
	cat "$work/ranked"
}

# Profiles in LOCATIONS_DIR for an optional country code (filename prefix)
list_profiles() {
	local country="${1:-}"
	if [[ -n $country && ! $country =~ ^[A-Za-z]{2}$ ]]; then
		echo "Invalid country code: $country" >&2
		return 1
	fi
	country="${country,,}"
	[[ -d $LOCATIONS_DIR ]] || {
		echo "No VPN locations directory found" >&2
		return 1
	}
	find "$LOCATIONS_DIR" -maxdepth 3 -type f -name "*.ovpn" 2> /dev/null |
		if [[ -n $country ]]; then
			grep -iE "/${country}([-_.#]|[0-9])[^/]*$" || true
		else
			cat
		fi
}

best_profile_name() {
	local max_age="$1" country="${2:-}" best
	best=$(list_profiles "$country" | rank_profiles "$max_age" | head -1 | cut -f2) || true
	if [[ -z $best ]]; then
		echo "No reachable VPN server found" >&2
		return 1
	fi
	basename "$best" | sed 's/\.\(ovpn\|conf\)$//'
}

case "${1:-}" in
	"help" | "-h" | "--help")
		usage
		;;
	"__measure")
		measure_target "${2:-}"
		;;
	"rank")
		max_age=0
		if [[ ${2:-} == "--max-age" ]]; then
			max_age="${3:-0}"
			[[ $max_age =~ ^[0-9]+$ ]] || {
				echo "Invalid --max-age: $max_age" >&2
				exit 1
			}
		fi
		rank_profiles "$max_age"
		;;
	"best")
		best_profile_name "$FAST_MAX_AGE" "${2:-}"
		;;
	"fresh")
		best_profile_name 0 "${2:-}"
		;;
	"test")
		results=$(list_profiles "${2:-}" | rank_profiles 0) || {
			echo "No reachable VPN server found" >&2
			exit 1
		}
		printf '%-10s %s\n' "RTT (ms)" "Profile"
		while IFS=$'\t' read -r rtt path; do
			printf '%-10s %s\n' "$rtt" "$(basename "$path")"
		done <<< "$results"
		;;
	"cache")
		if [[ -s $CACHE_FILE ]]; then
			echo "Performance cache contents (epoch, rtt_ms, method, profile):"
			cat "$CACHE_FILE"
		else
			echo "No performance cache found"
		fi
		;;
	"clear")
		rm -f "$CACHE_FILE"
		echo "Performance cache cleared"
		;;
	*)
		usage >&2
		exit 1
		;;
esac
