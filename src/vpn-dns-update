#!/bin/sh
# ABOUTME: OpenVPN up/down helper - applies the VPN's pushed DNS servers via resolvconf
# ABOUTME: Installed root-owned; the connector only passes it to OpenVPN if it is

# OpenVPN runs this as root with:
#   script_type=up|down, dev=<tun device>,
#   foreign_option_N="dhcp-option DNS <addr>" / "dhcp-option DOMAIN <name>" ...
# On up, the pushed nameservers are registered with resolvconf for the tunnel
# (exclusively, with openresolv's -x), so DNS no longer goes to the local
# router/ISP. On down, the entry is removed and the previous DNS comes back.
# Every pushed value is validated before use; nothing is evaluated.

set -f # pushed option values must never be glob-expanded

log() {
	logger -t vpn-dns-update "$1" 2> /dev/null || true
}

dev="${dev:-}"
case "$dev" in
	"" | *[!A-Za-z0-9_.-]*)
		log "refusing invalid device name"
		exit 1
		;;
esac
entry="$dev.protonvpn"

if ! command -v resolvconf > /dev/null 2>&1; then
	log "resolvconf not found; DNS left unchanged"
	exit 0
fi

valid_ip() {
	case "$1" in
		"" | *[!0-9.]*) ;;
		*)
			# dotted IPv4, 4 numeric parts of at most 3 digits
			echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$' && return 0
			;;
	esac
	case "$1" in
		"" | *[!0-9A-Fa-f:]*) return 1 ;;
		*:*) return 0 ;; # IPv6
	esac
	return 1
}

valid_domain() {
	echo "$1" | grep -Eq '^[A-Za-z0-9]([A-Za-z0-9-]{0,62})(\.[A-Za-z0-9]([A-Za-z0-9-]{0,62}))*\.?$'
}

case "${script_type:-}" in
	up)
		nl='
'
		servers=""
		domains=""
		i=1
		while :; do
			opt=$(printenv "foreign_option_$i") || break
			[ -n "$opt" ] || break
			# shellcheck disable=SC2086  # split "dhcp-option KIND VALUE" (globbing is off)
			set -- $opt
			if [ "${1:-}" = "dhcp-option" ]; then
				case "${2:-}" in
					DNS | DNS6)
						if valid_ip "${3:-}"; then
							servers="${servers}nameserver $3$nl"
						else
							log "ignoring invalid pushed DNS server"
						fi
						;;
					DOMAIN | DOMAIN-SEARCH)
						if valid_domain "${3:-}"; then
							domains="$domains $3"
						else
							log "ignoring invalid pushed domain"
						fi
						;;
				esac
			fi
			i=$((i + 1))
		done

		if [ -z "$servers" ]; then
			log "server pushed no DNS servers; DNS left unchanged"
			exit 0
		fi
		conf="$servers"
		[ -n "$domains" ] && conf="search${domains}$nl$conf"

		# openresolv: -x makes this the only DNS source while the tunnel is up.
		# Other resolvconf implementations do not know -x; fall back without it.
		if printf '%s' "$conf" | resolvconf -x -a "$entry" 2> /dev/null; then
			log "applied VPN DNS for $dev (exclusive)"
		elif printf '%s' "$conf" | resolvconf -a "$entry"; then
			log "applied VPN DNS for $dev"
		else
			log "resolvconf failed to apply VPN DNS for $dev"
		fi
		;;
	down)
		resolvconf -f -d "$entry" 2> /dev/null || true
		log "removed VPN DNS for $dev"
		;;
esac

exit 0
