#!/bin/bash
# ABOUTME: VPN kill switch implementation using iptables for leak protection
# ABOUTME: Blocks all non-VPN traffic when enabled to prevent data leaks on disconnect

set -euo pipefail

# Script locations - robust detection for installed vs development mode
if [[ -f "/usr/local/bin/vpn-manager" ]] && [[ -f "/usr/local/bin/vpn-error-handler" ]]; then
    VPN_DIR="/usr/local/bin"
else
    VPN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
fi

# Source dependencies
source "$VPN_DIR/vpn-colors"
source "$VPN_DIR/vpn-error-handler"

# Detect the real user when running as root (sleep/network hooks, sudo).
# HOME may be unset or /root there; never guess between several logged-in users.
# shellcheck source=src/vpn-utils
source "$VPN_DIR/vpn-utils"
REAL_USER=""
REAL_GROUP=""
if [[ $EUID -eq 0 ]]; then
    REAL_USER=$(detect_real_user) || REAL_USER=""
    if [[ -n $REAL_USER ]]; then
        REAL_GROUP=$(id -gn "$REAL_USER" 2> /dev/null || true)
        if [[ -z ${HOME:-} || ${HOME:-} == "/root" ]]; then
            HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
            export HOME
        fi
    fi
elif [[ -z ${HOME:-} ]]; then
    HOME=$(getent passwd "$EUID" | cut -d: -f6)
    export HOME
fi
export REAL_USER REAL_GROUP

# Configuration
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vpn"
STATE_FILE="$STATE_DIR/kill_switch.state"
CONFIG_DIR="${VPN_CONFIG_DIR:-$HOME/.config/vpn}"
# OpenVPN logs into the connector's root-owned session directory
SESSION_DIR="${VPN_SESSION_DIR:-/run/protonvpn-manager-session}"

# Read KEY=value from ~/.config/vpn/config (quotes stripped)
config_value() {
    local key="$1" default="${2:-}" value=""
    if [[ -f "$CONFIG_DIR/config" && ! -L "$CONFIG_DIR/config" ]]; then
        value=$(grep -E "^${key}=" "$CONFIG_DIR/config" 2> /dev/null | tail -1 | cut -d= -f2- | tr -d "\"'")
    fi
    echo "${value:-$default}"
}

# Chain names for iptables rules
CHAIN_NAME="VPN_KILL_SWITCH"
CHAIN_NAME_V6="VPN_KILL_SWITCH_V6"

# VPN interface (OpenVPN typically uses tun0)
VPN_INTERFACE="${VPN_INTERFACE:-tun0}"
# Security: the name ends up in firewall rules; accept only valid ifnames
if [[ ! $VPN_INTERFACE =~ ^[a-zA-Z0-9_.-]{1,15}$ ]]; then
    echo -e "${RED}Error: Invalid VPN interface name: $VPN_INTERFACE${NC}" >&2
    exit 1
fi

# Ensure state directory exists (private, not a symlink, owned by the real user)
secure_user_dir "$STATE_DIR" 2> /dev/null || true

# Check if running as root or can use sudo
check_privileges() {
    if [[ $EUID -eq 0 ]]; then
        return 0
    fi
    if sudo -n true 2> /dev/null; then
        return 0
    fi
    echo -e "${RED}Error: Kill switch requires root privileges${NC}"
    echo "Please run with sudo or ensure passwordless sudo is configured"
    return 1
}

# Run iptables command with appropriate privileges
run_iptables() {
    if [[ $EUID -eq 0 ]]; then
        iptables "$@"
    else
        sudo iptables "$@"
    fi
}

# Run ip6tables command with appropriate privileges
run_ip6tables() {
    if [[ $EUID -eq 0 ]]; then
        ip6tables "$@"
    else
        sudo ip6tables "$@"
    fi
}

# Apply a ruleset atomically (stdin) without flushing unrelated chains
run_iptables_restore() {
    if [[ $EUID -eq 0 ]]; then
        iptables-restore --noflush
    else
        sudo iptables-restore --noflush
    fi
}

run_ip6tables_restore() {
    if [[ $EUID -eq 0 ]]; then
        ip6tables-restore --noflush
    else
        sudo ip6tables-restore --noflush
    fi
}

# Check if iptables is available
check_iptables() {
    if ! command -v iptables &> /dev/null; then
        echo -e "${RED}Error: iptables not found${NC}"
        echo "Please install iptables: sudo pacman -S iptables"
        return 1
    fi
    return 0
}

# Check if kill switch chain exists
chain_exists() {
    run_iptables -L "$CHAIN_NAME" -n &> /dev/null
}

# Check if IPv6 chain exists
chain_exists_v6() {
    run_ip6tables -L "$CHAIN_NAME_V6" -n &> /dev/null
}

# Get the current VPN server IP from the active connection
# Returns the ACTUAL VPN server IP (the one traffic goes to before entering the tunnel)
get_vpn_server_ip() {
    local vpn_ip=""

    # Method 0: OpenVPN's own log of the current session (most reliable)
    local ovpn_log="$SESSION_DIR/openvpn.log"
    if [[ -f "$ovpn_log" && ! -L "$ovpn_log" ]]; then
        vpn_ip=$(grep -oE '(link remote|Peer Connection Initiated with|connection established with): \[AF_INET\][0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$ovpn_log" 2> /dev/null |
            tail -1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' || true)
    fi

    # Method 1: Find the VPN server from routing table - it's the IP routed via physical interface
    # When VPN is connected, there's a specific route for the VPN server via wlan0/eth0
    # This is the actual server IP we need to allow through the firewall
    local default_iface=""
    default_iface=$(ip route show default 2> /dev/null | awk '/default/ {for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -1)
    if [[ -z "$vpn_ip" && -n "$default_iface" ]]; then
        # Find IPs that are routed via the physical interface (not tun0)
        # These are typically VPN server IPs that need to bypass the tunnel
        # Prefer host routes (no /prefix) - that's what OpenVPN adds for the server
        vpn_ip=$(ip route show 2> /dev/null | grep "via.*dev $default_iface" | grep -v "default" | awk '{print $1}' | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | head -1)
    fi

    if [[ -z "$vpn_ip" ]]; then
        # Method 2: Check OpenVPN process arguments via /proc
        # shellcheck disable=SC2009  # ps | grep needed for extracting --remote argument
        vpn_ip=$(ps aux 2> /dev/null | grep 'openvpn.*--remote' | sed -n 's/.*--remote \([0-9.]*\).*/\1/p' | head -1)
    fi

    if [[ -z "$vpn_ip" ]]; then
        # Method 3: Check the saved state file for last known server
        if [[ -f "$STATE_FILE" ]]; then
            vpn_ip=$(grep "^server_ip=" "$STATE_FILE" 2> /dev/null | cut -d= -f2)
        fi
    fi

    # Only ever return a well-formed IPv4 address (it ends up in firewall rules)
    if [[ "$vpn_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        echo "$vpn_ip"
    fi
}

# Get the default gateway IP
get_default_gateway() {
    ip route show default 2> /dev/null | awk '/default/ {for(i=1;i<=NF;i++) if($i=="via") print $(i+1)}' | head -1
}

# Check if VPN tunnel interface exists
check_vpn_interface() {
    ip link show "$VPN_INTERFACE" &> /dev/null
}

# Enable the kill switch
enable_kill_switch() {
    local vpn_server_ip="${1:-}"

    echo -e "${YELLOW}Enabling VPN kill switch...${NC}"

    if ! check_iptables; then
        return 1
    fi

    if ! check_privileges; then
        return 1
    fi

    # Get VPN server IP if not provided
    if [[ -z "$vpn_server_ip" ]]; then
        vpn_server_ip=$(get_vpn_server_ip)
    fi

    # Safety check: Ensure VPN is actually connected before enabling
    if ! check_vpn_interface; then
        echo -e "${RED}Error: VPN interface ($VPN_INTERFACE) not found${NC}"
        echo ""
        echo "The kill switch requires an active VPN connection to function properly."
        echo "Without a VPN tunnel, enabling the kill switch will block ALL internet traffic."
        echo ""
        echo "Please connect to VPN first:"
        echo "  vpn connect"
        echo ""
        echo "Or if you want to force enable (advanced users only):"
        echo "  vpn kill-switch enable --force"
        return 1
    fi

    # Verify we have a VPN server IP
    if [[ -z "$vpn_server_ip" ]]; then
        echo -e "${YELLOW}Warning: Could not determine VPN server IP${NC}"
        echo "Kill switch may not allow VPN reconnection if the tunnel drops."
        echo ""
    fi

    # DNS to the local gateway bypasses the tunnel (a DNS leak), so it is only
    # allowed on explicit opt-in. The connector's DNS helper points DNS at the
    # VPN's servers, which go through the tunnel like all other traffic.
    local default_gw=""
    if [[ "$(config_value KILL_SWITCH_ALLOW_LAN_DNS false)" == "true" ]]; then
        default_gw=$(get_default_gateway)
        [[ "$default_gw" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || default_gw=""
    fi
    local have_tailscale=""
    ip link show tailscale0 &> /dev/null && have_tailscale=1

    # Build both rulesets and apply each with ONE iptables-restore transaction.
    # Declaring the chain in --noflush mode flushes and refills it atomically,
    # so a refresh never leaves a window where the chain is empty (fail-open),
    # and it needs 2 privileged calls instead of ~20.
    local v4 v6
    v4="*filter
:$CHAIN_NAME - [0:0]
-A $CHAIN_NAME -o lo -j ACCEPT
-A $CHAIN_NAME -i lo -j ACCEPT
-A $CHAIN_NAME -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT"
    [[ -n "$vpn_server_ip" ]] && v4+="
-A $CHAIN_NAME -d $vpn_server_ip -j ACCEPT"
    v4+="
-A $CHAIN_NAME -o $VPN_INTERFACE -j ACCEPT"
    [[ -n "$have_tailscale" ]] && v4+="
-A $CHAIN_NAME -o tailscale0 -j ACCEPT"
    # libvirt/QEMU default VM network; DHCP client->server only
    v4+="
-A $CHAIN_NAME -d 192.168.122.0/24 -j ACCEPT
-A $CHAIN_NAME -p udp --sport 68 --dport 67 -j ACCEPT"
    # Opt-in only (KILL_SWITCH_ALLOW_LAN_DNS=true): DNS to the local gateway
    [[ -n "$default_gw" ]] && v4+="
-A $CHAIN_NAME -d $default_gw -p udp --dport 53 -j ACCEPT
-A $CHAIN_NAME -d $default_gw -p tcp --dport 53 -j ACCEPT"
    v4+="
-A $CHAIN_NAME -j DROP"
    if ! run_iptables -C OUTPUT -j "$CHAIN_NAME" 2> /dev/null; then
        v4+="
-I OUTPUT 1 -j $CHAIN_NAME"
    fi
    v4+="
COMMIT"

    v6="*filter
:$CHAIN_NAME_V6 - [0:0]
-A $CHAIN_NAME_V6 -o lo -j ACCEPT
-A $CHAIN_NAME_V6 -i lo -j ACCEPT
-A $CHAIN_NAME_V6 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A $CHAIN_NAME_V6 -o $VPN_INTERFACE -j ACCEPT"
    [[ -n "$have_tailscale" ]] && v6+="
-A $CHAIN_NAME_V6 -o tailscale0 -j ACCEPT"
    v6+="
-A $CHAIN_NAME_V6 -j DROP"
    if ! run_ip6tables -C OUTPUT -j "$CHAIN_NAME_V6" 2> /dev/null; then
        v6+="
-I OUTPUT 1 -j $CHAIN_NAME_V6"
    fi
    v6+="
COMMIT"

    echo "  Setting up IPv4 rules..."
    [[ -n "$vpn_server_ip" ]] && echo "  Allowing VPN server: $vpn_server_ip"
    [[ -n "$have_tailscale" ]] && echo "  Allowing Tailscale traffic: tailscale0"
    [[ -n "$default_gw" ]] && echo "  Allowing DNS to gateway (KILL_SWITCH_ALLOW_LAN_DNS): $default_gw"
    if ! run_iptables_restore <<< "$v4"; then
        echo -e "${RED}Error: Failed to apply IPv4 kill switch rules${NC}" >&2
        return 1
    fi

    echo "  Setting up IPv6 rules..."
    if ! run_ip6tables_restore <<< "$v6"; then
        echo -e "${RED}Error: Failed to apply IPv6 kill switch rules${NC}" >&2
        return 1
    fi

    # Save state
    save_state "enabled" "$vpn_server_ip"

    echo -e "${GREEN}✓ Kill switch enabled${NC}"
    echo "  - All non-VPN traffic is now blocked"
    echo "  - Traffic allowed through: $VPN_INTERFACE"
    [[ -n "$vpn_server_ip" ]] && echo "  - VPN server: $vpn_server_ip"

    return 0
}

# Disable the kill switch (intentional disconnect)
disable_kill_switch() {
    echo -e "${YELLOW}Disabling VPN kill switch...${NC}"

    if ! check_privileges; then
        return 1
    fi

    # Remove IPv4 chain from OUTPUT (every jump: an interrupted run can leave
    # duplicates, and the chain cannot be deleted while one remains)
    while run_iptables -C OUTPUT -j "$CHAIN_NAME" 2> /dev/null; do
        run_iptables -D OUTPUT -j "$CHAIN_NAME" || break
    done

    # Flush and delete IPv4 chain
    if chain_exists; then
        run_iptables -F "$CHAIN_NAME"
        run_iptables -X "$CHAIN_NAME"
    fi

    # Remove IPv6 chain from OUTPUT (every jump, see above)
    while run_ip6tables -C OUTPUT -j "$CHAIN_NAME_V6" 2> /dev/null; do
        run_ip6tables -D OUTPUT -j "$CHAIN_NAME_V6" || break
    done

    # Flush and delete IPv6 chain
    if chain_exists_v6; then
        run_ip6tables -F "$CHAIN_NAME_V6"
        run_ip6tables -X "$CHAIN_NAME_V6"
    fi

    # Update state
    save_state "disabled" ""

    echo -e "${GREEN}✓ Kill switch disabled${NC}"
    echo "  - Normal network traffic restored"

    return 0
}

# Emergency disable - removes all rules immediately
emergency_disable() {
    echo -e "${RED}Emergency kill switch disable...${NC}"

    # Try to disable without privilege check (best effort)
    sudo iptables -D OUTPUT -j "$CHAIN_NAME" 2> /dev/null || true
    sudo iptables -F "$CHAIN_NAME" 2> /dev/null || true
    sudo iptables -X "$CHAIN_NAME" 2> /dev/null || true

    sudo ip6tables -D OUTPUT -j "$CHAIN_NAME_V6" 2> /dev/null || true
    sudo ip6tables -F "$CHAIN_NAME_V6" 2> /dev/null || true
    sudo ip6tables -X "$CHAIN_NAME_V6" 2> /dev/null || true

    # Clear state
    rm -f "$STATE_FILE" 2> /dev/null || true

    echo -e "${GREEN}✓ Emergency disable complete${NC}"
    return 0
}

# Check if kill switch is enabled: either half blocks traffic on its own
# (a leftover IPv6 jump without the IPv4 one still needs disabling)
is_enabled() {
    if chain_exists && run_iptables -C OUTPUT -j "$CHAIN_NAME" 2> /dev/null; then
        return 0 # Enabled
    fi
    if chain_exists_v6 && run_ip6tables -C OUTPUT -j "$CHAIN_NAME_V6" 2> /dev/null; then
        return 0 # Enabled (IPv6 only)
    fi
    return 1 # Disabled
}

# Save state to file
save_state() {
    local status="$1"
    local server_ip="${2:-}"

    secure_user_dir "$STATE_DIR" || return 0

    # Write to a unique temp file and rename over the target: rename never
    # follows a symlink planted at STATE_FILE (matters when running as root).
    local tmp
    tmp=$(mktemp "$STATE_DIR/.kill_switch.state.XXXXXX") || return 0
    printf 'status=%s\nserver_ip=%s\ntimestamp=%s\ninterface=%s\n' \
        "$status" "$server_ip" "$(date +%s)" "$VPN_INTERFACE" > "$tmp"
    chmod 600 "$tmp" 2> /dev/null || true

    # Fix ownership when running as root
    if [[ $EUID -eq 0 && -n "${REAL_USER:-}" && -n "${REAL_GROUP:-}" ]]; then
        chown -h "$REAL_USER:$REAL_GROUP" "$tmp" 2> /dev/null || true
    fi
    mv -f "$tmp" "$STATE_FILE" 2> /dev/null || rm -f "$tmp"
}

# Show current status
show_status() {
    echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║         VPN Kill Switch Status         ║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
    echo ""

    # Check iptables availability
    if ! command -v iptables &> /dev/null; then
        echo -e "iptables: ${RED}not installed${NC}"
        return 1
    fi
    echo -e "iptables: ${GREEN}available${NC}"

    # Check if enabled
    if is_enabled; then
        echo -e "Status: ${GREEN}ENABLED${NC}"
        echo ""

        # Show IPv4 rules
        echo "IPv4 Rules:"
        if sudo -n iptables -L "$CHAIN_NAME" -n 2> /dev/null; then
            :
        else
            echo "  (requires sudo to view)"
        fi

        echo ""
        echo "IPv6 Rules:"
        if sudo -n ip6tables -L "$CHAIN_NAME_V6" -n 2> /dev/null; then
            :
        else
            echo "  (requires sudo to view)"
        fi
    else
        echo -e "Status: ${YELLOW}DISABLED${NC}"
    fi

    # Show state file info
    if [[ -f "$STATE_FILE" ]]; then
        echo ""
        echo "State file: $STATE_FILE"
        local saved_status=""
        saved_status=$(grep "^status=" "$STATE_FILE" 2> /dev/null | cut -d= -f2)
        echo "  Saved status: $saved_status"

        local saved_ip=""
        saved_ip=$(grep "^server_ip=" "$STATE_FILE" 2> /dev/null | cut -d= -f2)
        [[ -n "$saved_ip" ]] && echo "  Last VPN server: $saved_ip"
    fi

    return 0
}

# Show help
show_help() {
    echo -e "${CYAN}VPN Kill Switch - Leak Protection${NC}"
    echo ""
    echo "Usage: vpn-kill-switch <command> [options]"
    echo ""
    echo "Commands:"
    echo "  enable [server_ip]  - Enable kill switch (requires active VPN connection)"
    echo "  enable --force      - Force enable without VPN check (DANGEROUS)"
    echo "  disable             - Disable kill switch (allows normal traffic)"
    echo "  refresh             - Update rules for current network (after WiFi change)"
    echo "  emergency           - Emergency disable (force remove all rules)"
    echo "  status              - Show current kill switch status"
    echo "  is-enabled          - Check if enabled (exit code: 0=yes, 1=no)"
    echo "  help                - Show this help message"
    echo ""
    echo "The kill switch blocks all network traffic except:"
    echo "  - Loopback (localhost)"
    echo "  - Established connections"
    echo "  - Traffic to VPN server"
    echo "  - Traffic through VPN tunnel ($VPN_INTERFACE)"
    echo ""
    echo -e "${YELLOW}IMPORTANT:${NC} Only enable the kill switch when VPN is connected."
    echo "Enabling without VPN will block ALL internet traffic!"
    echo ""
    echo "This prevents data leaks when VPN disconnects unexpectedly."
}

# Main command handler
case "${1:-}" in
    "enable" | "on")
        # Check for --force flag anywhere in arguments
        FORCE_MODE=""
        SERVER_IP=""
        for arg in "${@:2}"; do
            if [[ "$arg" == "--force" ]]; then
                FORCE_MODE="true"
            elif [[ "$arg" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
                SERVER_IP="$arg"
            fi
        done

        if [[ -n "$FORCE_MODE" ]]; then
            # Force mode: skip VPN interface check
            VPN_INTERFACE="${VPN_INTERFACE:-tun0}"
            # Create a dummy check function that always succeeds
            check_vpn_interface() { return 0; }
        fi
        enable_kill_switch "$SERVER_IP"
        ;;
    "disable" | "off")
        disable_kill_switch
        ;;
    "emergency" | "emergency-off" | "force-off")
        emergency_disable
        ;;
    "status" | "s")
        show_status
        ;;
    "is-enabled" | "check")
        is_enabled
        exit $?
        ;;
    "refresh" | "update")
        # Refresh kill switch rules with current network settings
        # Useful after network changes (wake from sleep, new WiFi, etc.)
        if is_enabled; then
            echo -e "${YELLOW}Refreshing kill switch rules...${NC}"
            # Re-enable with current network settings (will flush and re-add rules)
            enable_kill_switch
        else
            echo -e "${YELLOW}Kill switch not enabled, nothing to refresh${NC}"
            exit 0
        fi
        ;;
    "help" | "h" | "-h" | "--help")
        show_help
        ;;
    *)
        show_help
        exit 1
        ;;
esac
