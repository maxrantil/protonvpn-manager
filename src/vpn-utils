#!/bin/bash
# ABOUTME: Shared utility functions for VPN scripts
# ABOUTME: Provides logging and notification functions used across components

# Simple notification function for basic feedback
# Usage: notify_event "event_type" ["arg1"] ["arg2"]
# Output: [INFO] event_type: arg1 arg2
notify_event() {
    local event_type="$1"
    local arg1="${2:-}"
    local arg2="${3:-}"
    echo "[INFO] $event_type: $arg1 $arg2" >&2
}

# Log message function with timestamp
# Usage: log_message "message" "log_file_path"
# Format: [YYYY-MM-DD HH:MM:SS] message
# Note: If log_file is omitted, outputs to stderr only
log_message() {
    local message="$1"
    local log_file="${2:-}"

    local timestamp
    timestamp="[$(date '+%Y-%m-%d %H:%M:%S')]"

    # If no log file specified, output to stderr only
    if [[ -z "$log_file" ]]; then
        echo "$timestamp $message" >&2
        return 0
    fi

    # Try to write to log file
    if echo "$timestamp $message" >> "$log_file" 2> /dev/null; then
        return 0
    else
        # Fallback to stderr if log file not writable
        echo "$timestamp $message" >&2
        return 0
    fi
}

# Determine the unprivileged user root is acting for (sleep/network hooks, sudo)
# Order: SUDO_USER -> VPN_USER in root-owned /etc/protonvpn-manager.conf ->
# the single non-root user logged in. With several users logged in and no
# configuration the result is empty: root must never guess whose home to use.
# Output: username (may be empty). Returns 0 if a user was found.
detect_real_user() {
    local user="" conf="${VPN_SYSTEM_CONF:-/etc/protonvpn-manager.conf}"

    if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        user="$SUDO_USER"
    elif [[ -f "$conf" && ! -L "$conf" ]] && [[ "$(stat -c %u "$conf" 2> /dev/null)" == "0" ]]; then
        user=$(sed -n 's/^VPN_USER=["'\'']\{0,1\}\([a-z_][a-z0-9_-]*\)["'\'']\{0,1\}$/\1/p' "$conf" 2> /dev/null | head -1)
    fi

    if [[ -z "$user" ]]; then
        local users
        users=$(who 2> /dev/null | awk '$1 != "root" {print $1}' | sort -u)
        if [[ -n "$users" && $(wc -l <<< "$users") -eq 1 ]]; then
            user="$users"
        fi
    fi

    # Must be a sane, existing, non-root account
    if [[ ! "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || [[ "$user" == "root" ]] || ! getent passwd "$user" > /dev/null 2>&1; then
        return 1
    fi
    echo "$user"
}

# Create/verify a private per-user directory (700, not a symlink, owned by the
# current user or by REAL_USER when running as root). chown -h never follows
# symlinks, so root cannot be tricked into chowning another path.
# Args: $1 = directory
# Returns: 0 if the directory is safe to use
secure_user_dir() {
    local dir="$1"
    if [[ -L "$dir" ]]; then
        echo "ERROR: Refusing to use symlinked directory: $dir" >&2
        return 1
    fi
    (umask 077 && mkdir -p "$dir") 2> /dev/null || return 1
    if [[ -L "$dir" || ! -d "$dir" ]]; then
        echo "ERROR: Refusing to use directory: $dir" >&2
        return 1
    fi

    local owner expected
    owner=$(stat -c %U "$dir" 2> /dev/null)
    expected=$(id -un)
    if [[ $EUID -eq 0 && -n "${REAL_USER:-}" && "${REAL_USER}" != "root" ]]; then
        expected="$REAL_USER"
        if [[ "$owner" == "root" ]]; then
            chown -h "$REAL_USER:" "$dir" 2> /dev/null || true
            owner=$(stat -c %U "$dir" 2> /dev/null)
        fi
    fi
    if [[ "$owner" != "$expected" ]]; then
        echo "ERROR: Directory $dir is owned by '$owner', expected '$expected'" >&2
        return 1
    fi
    chmod 700 "$dir" 2> /dev/null || true
    return 0
}

# Remove the VPN's DNS entries from resolvconf: <dev>.protonvpn (added by
# vpn-dns-update) and tunN.* (added by OpenVPN's update-resolv-conf script in
# older setups). OpenVPN removes its entry itself on a clean exit; this covers
# a crash, KILL or interrupted connect, which would leave DNS pointing at the
# dead tunnel's server. Only call this when no VPN is running.
clear_vpn_dns() {
    command -v resolvconf > /dev/null 2>&1 || return 0
    local entry
    # openresolv lists registered entries with -i; other implementations
    # don't know -i and print nothing useful, which is handled as "none"
    for entry in $(resolvconf -i 2> /dev/null); do
        [[ $entry =~ ^[A-Za-z0-9_-]+\.protonvpn$ || $entry =~ ^tun[0-9]+\.[A-Za-z0-9_-]+$ ]] || continue
        sudo resolvconf -f -d "$entry" 2> /dev/null || true
    done
    return 0
}

# Undo what a VPN session leaves in the network config once no VPN runs:
# the VPN's DNS entry and the kill switch. Callers that keep the kill switch
# on purpose (sleep/reconnect hooks) set VPN_KEEP_KILL_SWITCH=1.
# Uses $VPN_DIR of the calling script.
release_vpn_network_state() {
    clear_vpn_dns
    [[ ${VPN_KEEP_KILL_SWITCH:-} == 1 ]] && return 0
    local kill_switch="${VPN_DIR:-/usr/local/bin}/vpn-kill-switch"
    [[ -x $kill_switch ]] || return 0
    "$kill_switch" is-enabled 2> /dev/null || return 0
    echo "Disabling kill switch..."
    "$kill_switch" disable
}

# Export functions for use in other scripts
export -f notify_event
export -f log_message
export -f detect_real_user
export -f secure_user_dir
export -f clear_vpn_dns
export -f release_vpn_network_state
