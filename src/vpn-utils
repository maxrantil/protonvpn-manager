#!/bin/bash
# ABOUTME: Shared utility functions for VPN scripts
# ABOUTME: Provides logging and notification functions used across components

# Simple notification function for basic feedback
# Usage: notify_event "event_type" ["arg1"] ["arg2"]
# Output: [INFO] event_type: arg1 arg2
notify_event() {
    local event_type="$1"
    local arg1="${2:-}"
    local arg2="${3:-}"
    echo "[INFO] $event_type: $arg1 $arg2" >&2
}

# Log message function with timestamp
# Usage: log_message "message" "log_file_path"
# Format: [YYYY-MM-DD HH:MM:SS] message
# Note: If log_file is omitted, outputs to stderr only
log_message() {
    local message="$1"
    local log_file="${2:-}"

    local timestamp
    timestamp="[$(date '+%Y-%m-%d %H:%M:%S')]"

    # If no log file specified, output to stderr only
    if [[ -z "$log_file" ]]; then
        echo "$timestamp $message" >&2
        return 0
    fi

    # Try to write to log file
    if echo "$timestamp $message" >> "$log_file" 2> /dev/null; then
        return 0
    else
        # Fallback to stderr if log file not writable
        echo "$timestamp $message" >&2
        return 0
    fi
}

# Determine the unprivileged user root is acting for (sleep/network hooks, sudo)
# Order: SUDO_USER -> VPN_USER in root-owned /etc/protonvpn-manager.conf ->
# the single non-root user logged in. With several users logged in and no
# configuration the result is empty: root must never guess whose home to use.
# Output: username (may be empty). Returns 0 if a user was found.
detect_real_user() {
    local user="" conf="${VPN_SYSTEM_CONF:-/etc/protonvpn-manager.conf}"

    if [[ -n "${SUDO_USER:-}" && "${SUDO_USER}" != "root" ]]; then
        user="$SUDO_USER"
    elif [[ -f "$conf" && ! -L "$conf" ]] && [[ "$(stat -c %u "$conf" 2> /dev/null)" == "0" ]]; then
        user=$(sed -n 's/^VPN_USER=["'\'']\{0,1\}\([a-z_][a-z0-9_-]*\)["'\'']\{0,1\}$/\1/p' "$conf" 2> /dev/null | head -1)
    fi

    if [[ -z "$user" ]]; then
        local users
        users=$(who 2> /dev/null | awk '$1 != "root" {print $1}' | sort -u)
        if [[ -n "$users" && $(wc -l <<< "$users") -eq 1 ]]; then
            user="$users"
        fi
    fi

    # Must be a sane, existing, non-root account
    if [[ ! "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || [[ "$user" == "root" ]] || ! getent passwd "$user" > /dev/null 2>&1; then
        return 1
    fi
    echo "$user"
}

# Create/verify a private per-user directory (700, not a symlink, owned by the
# current user or by REAL_USER when running as root). chown -h never follows
# symlinks, so root cannot be tricked into chowning another path.
# Args: $1 = directory
# Returns: 0 if the directory is safe to use
secure_user_dir() {
    local dir="$1"
    if [[ -L "$dir" ]]; then
        echo "ERROR: Refusing to use symlinked directory: $dir" >&2
        return 1
    fi
    (umask 077 && mkdir -p "$dir") 2> /dev/null || return 1
    if [[ -L "$dir" || ! -d "$dir" ]]; then
        echo "ERROR: Refusing to use directory: $dir" >&2
        return 1
    fi

    local owner expected
    owner=$(stat -c %U "$dir" 2> /dev/null)
    expected=$(id -un)
    if [[ $EUID -eq 0 && -n "${REAL_USER:-}" && "${REAL_USER}" != "root" ]]; then
        expected="$REAL_USER"
        if [[ "$owner" == "root" ]]; then
            chown -h "$REAL_USER:" "$dir" 2> /dev/null || true
            owner=$(stat -c %U "$dir" 2> /dev/null)
        fi
    fi
    if [[ "$owner" != "$expected" ]]; then
        echo "ERROR: Directory $dir is owned by '$owner', expected '$expected'" >&2
        return 1
    fi
    chmod 700 "$dir" 2> /dev/null || true
    return 0
}

# Remove the VPN's DNS entries from resolvconf: <dev>.protonvpn (added by
# vpn-dns-update) and tunN.* (added by OpenVPN's update-resolv-conf script in
# older setups). OpenVPN removes its entry itself on a clean exit; this covers
# a crash, KILL or interrupted connect, which would leave DNS pointing at the
# dead tunnel's server. Only call this when no VPN is running.
clear_vpn_dns() {
    command -v resolvconf > /dev/null 2>&1 || return 0
    local entry
    # openresolv lists registered entries with -i; other implementations
    # don't know -i and print nothing useful, which is handled as "none"
    for entry in $(resolvconf -i 2> /dev/null); do
        [[ $entry =~ ^[A-Za-z0-9_-]+\.protonvpn$ || $entry =~ ^tun[0-9]+\.[A-Za-z0-9_-]+$ ]] || continue
        sudo resolvconf -f -d "$entry" 2> /dev/null || true
    done
    return 0
}

# openresolv rebuilds resolv.conf from its own entries only. When
# NetworkManager does not register with resolvconf (it keeps its copy in
# /run/NetworkManager/resolv.conf), removing the VPN's entry leaves
# resolv.conf without nameservers: DNS is dead, and Tailscale, re-enabled
# after, would back up that empty file as its upstream. Put NetworkManager's
# current DNS back in that case; a resolv.conf with nameservers is left alone.
restore_system_dns() {
    local resolv="${VPN_RESOLV_CONF:-/etc/resolv.conf}"
    local nm="${VPN_NM_RESOLV_CONF:-/run/NetworkManager/resolv.conf}"
    local record
    record=$(tailscale_dns_record)
    # Tailscale in resolvconf mode registers with openresolv, which only
    # rewrites a resolv.conf carrying its own signature: never copy a foreign
    # file in then, rebuild it with resolvconf instead
    if [[ -f $record ]] && grep -qx 'mode=resolvconf' "$record"; then
        sudo resolvconf -u 2> /dev/null || true
        return 0
    fi
    grep -q '^nameserver' "$resolv" 2> /dev/null && return 0
    [[ -f $nm && ! -L $nm ]] && grep -q '^nameserver' "$nm" 2> /dev/null || return 0
    sudo install -m 644 "$nm" "$resolv"
}

# Tailscale with MagicDNS owns /etc/resolv.conf (100.100.100.100) and sends
# lookups to the ISP's resolver outside the tunnel: a DNS leak, and with the
# kill switch on nothing resolves at all. While a VPN is connected its DNS is
# paused, so resolv.conf comes from resolvconf (the VPN's exclusive entry).
# The record file means "we paused it": a setting the user turned off
# themselves is never turned back on.
tailscale_dns_record() {
    echo "${XDG_STATE_HOME:-$HOME/.local/state}/vpn/tailscale-dns-paused"
}

# Running as root for a user (sleep/network hooks, sudo): files written into
# their home stay theirs, because the hooks read them back as the user.
# Uses REAL_USER/REAL_GROUP of the calling script (an empty group means the
# user's login group); no-op otherwise.
give_to_real_user() {
    [[ $EUID -eq 0 && -n ${REAL_USER:-} && $REAL_USER != root ]] || return 0
    chown -h "$REAL_USER:${REAL_GROUP:-}" "$@" 2> /dev/null || true
}

pause_tailscale_dns() {
    command -v tailscale > /dev/null 2>&1 || return 0
    # Only when tailscaled runs and manages DNS
    tailscale debug prefs 2> /dev/null | grep -q '"CorpDNS": true' || return 0
    local record
    record=$(tailscale_dns_record)
    secure_user_dir "$(dirname "$record")" || return 1
    # Record first (with how Tailscale manages DNS: its own resolv.conf, or
    # an entry in resolvconf): a crash after the change must still restore
    local mode=direct
    resolvconf -i 2> /dev/null | tr ' ' '\n' | grep -qx tailscale && mode=resolvconf
    # Never write through a symlink the user put in its place
    rm -f "$record"
    echo "mode=$mode" > "$record"
    give_to_real_user "$record"
    if ! sudo tailscale set --accept-dns=false > /dev/null 2>&1; then
        rm -f "$record"
        echo "WARNING: Could not pause Tailscale DNS; DNS may bypass the VPN" >&2
        return 1
    fi
    # Tailscale put back its pre-Tailscale resolv.conf (router/ISP DNS);
    # rebuild it from resolvconf, where the VPN's entry is exclusive
    sudo resolvconf -u 2> /dev/null || true
    echo "DNS goes through the VPN (Tailscale DNS paused until disconnect)"
}

restore_tailscale_dns() {
    local record
    record=$(tailscale_dns_record)
    [[ -f $record ]] || return 0
    if command -v tailscale > /dev/null 2>&1 && sudo tailscale set --accept-dns=true > /dev/null 2>&1; then
        rm -f "$record"
        # Switching DNS back on is no proof Tailscale took resolv.conf back
        local resolv="${VPN_RESOLV_CONF:-/etc/resolv.conf}" i
        for ((i = 0; i < ${VPN_TAILSCALE_TAKEOVER_WAIT:-5} * 2; i++)); do
            grep -q '^nameserver 100\.100\.100\.100' "$resolv" 2> /dev/null && return 0
            sleep 0.5
        done
        echo "WARNING: Tailscale DNS is on again, but Tailscale has not taken over resolv.conf:" >&2
        echo "  MagicDNS names (*.ts.net) won't resolve. If it persists, restart tailscaled" >&2
        echo "  (e.g. sudo sv restart tailscaled)." >&2
        return 0
    fi
    echo "WARNING: Could not restore Tailscale DNS; run: sudo tailscale set --accept-dns=true" >&2
    return 1
}

# Undo what a VPN session leaves in the network config once no VPN runs:
# the VPN's DNS entry, paused Tailscale DNS, the IPv6 block and the kill
# switch. Callers that keep the kill switch on purpose (sleep/reconnect
# hooks) set VPN_KEEP_KILL_SWITCH=1; it blocks IPv6 and DNS leaks itself.
# Uses $VPN_DIR of the calling script.
release_vpn_network_state() {
    clear_vpn_dns
    # Before Tailscale takes resolv.conf back, so it keeps a working upstream
    restore_system_dns || true
    restore_tailscale_dns || true
    # Callers set VPN_DIR; the fallback is this library's own directory
    local kill_switch="${VPN_DIR:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")}/vpn-kill-switch"
    [[ -x $kill_switch ]] || return 0
    "$kill_switch" ipv6-guard off > /dev/null 2>&1 || true
    [[ ${VPN_KEEP_KILL_SWITCH:-} == 1 ]] && return 0
    "$kill_switch" is-enabled 2> /dev/null || return 0
    echo "Disabling kill switch..."
    "$kill_switch" disable
}

# Export functions for use in other scripts
export -f notify_event
export -f log_message
export -f detect_real_user
export -f secure_user_dir
export -f clear_vpn_dns
export -f release_vpn_network_state
export -f restore_system_dns
export -f tailscale_dns_record
export -f give_to_real_user
export -f pause_tailscale_dns
export -f restore_tailscale_dns
